# ResearchSphere AI - Backend Configuration Template
PROJECT_NAME="ResearchSphere AI API"
API_V1_STR="/api"
ENVIRONMENT="development"
HOST="127.0.0.1"
PORT=8000

# PostgreSQL Database URL
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/researchsphere_dev"

# JWT Authentication
JWT_SECRET_KEY="dev_insecure_jwt_secret_key_change_in_production_1234567890"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Vector Database (Qdrant)
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="researchsphere_chunks"

# Embedding Model
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_BATCH_SIZE=32

# Groq LLM Configuration (Module 6)
# Get your free key at https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_TIMEOUT_SECONDS=30

